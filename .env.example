DISCORD_TOKEN=
BIG_CONFIG_PATH=config.yaml
# Safe default. Change to false only after configuring Discord and the target forum.
BIG_DRY_RUN=true

# Optional: makes slash-command changes appear immediately in one development server.
BIG_GUILD_ID=

# Required only for official X/Twitter feeds. RSS/Atom works without it.
X_BEARER_TOKEN=

# Optional story-level analysis. When unset, deterministic story summaries are used.
OPENROUTER_API_KEY=
BIG_OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
BIG_AI_WEB_SEARCH=true
BIG_AI_ZDR=true
BIG_RELATED_STORY_LIMIT=8

BIG_DATABASE_PATH=data/big.db
BIG_POLL_TICK_SECONDS=15
BIG_MAX_BACKFILL=3
BIG_HTTP_TIMEOUT_SECONDS=15
BIG_RSS_MAX_BYTES=2097152
BIG_LOG_LEVEL=INFO
BIG_HEALTH_HOST=0.0.0.0
BIG_HEALTH_PORT=8787
